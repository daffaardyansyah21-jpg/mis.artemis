# ─── Supabase ───────────────────────────────────────────────────────────────
# Salin file ini menjadi .env.local lalu isi nilai-nilainya.
# Dapatkan dari: https://supabase.com → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — hanya untuk server-side / admin scripts
# JANGAN ekspos di client!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Aplikasi ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Artemis

# ─── Cloudflare R2 Storage (opsional, untuk gambar soal) ─────────────────────
CLOUDFLARE_R2_BUCKET=artemis-assets
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-<hash>.r2.dev
